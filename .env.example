# Base de datos MySQL/MariaDB de Hostinger
DATABASE_URL=mysql://USUARIO:CONTRASEÑA@HOST:3306/BASE_DE_DATOS
# En Hostinger usa esta clave propia para evitar que una integración externa
# sobrescriba DATABASE_URL. Si existe, tiene prioridad.
VANEANDO_DATABASE_URL=mysql://USUARIO:CONTRASEÑA@HOST:3306/BASE_DE_DATOS

# Sesiones y documentos
JWT_SECRET=genera-una-clave-aleatoria-de-al-menos-32-caracteres
DOCUMENT_ENCRYPTION_KEY=genera-una-clave-de-al-menos-32-caracteres
UPLOAD_DIR=/home/u896809627/domains/vaneando.com/storage

# Administracion
ADMIN_EMAILS=admin@vaneando.com

# URL publica
NEXT_PUBLIC_APP_URL=https://vaneando.com

# Web Push (genera las claves con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@vaneando.com

# Correo saliente
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@vaneando.com
SMTP_PASSWORD=contraseña-real-del-buzón-admin
EMAIL_FROM=vaneando. <admin@vaneando.com>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cron de soporte
CRON_SECRET=
