# ==============================================================================
# GTR CARS - CONFIGURACIÓN DE ENTORNO DE PRODUCCIÓN Y STAGING
# ==============================================================================

# 1. Base de datos MySQL / MariaDB
# Soporta GTRCARS_DATABASE_URL (prioridad) o DATABASE_URL estándar
GTRCARS_DATABASE_URL=mysql://USUARIO:CONTRASEÑA@HOST:3306/BASE_DE_DATOS
DATABASE_URL=mysql://USUARIO:CONTRASEÑA@HOST:3306/BASE_DE_DATOS

# 2. Seguridad de Sesiones y Criptografía
# Genera hashes aleatorios de al menos 32 caracteres (ej. con openssl rand -base64 32)
JWT_SECRET=genera-una-clave-aleatoria-de-al-menos-32-caracteres
DOCUMENT_ENCRYPTION_KEY=genera-una-clave-de-al-menos-32-caracteres
UPLOAD_DIR=/home/u896809627/domains/gtrcars.es/storage

# 3. Cuentas de Administración VIP
ADMIN_EMAILS=admin@gtrcars.es,alecub96@gmail.com

# 4. URL Pública y Monitoreo
NEXT_PUBLIC_APP_URL=https://gtrcars.es
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
SENTRY_DSN=

# 5. Notificaciones Web Push (VAPID)
# Genera las claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@gtrcars.es

# 6. Servidor de Correo Saliente (SMTP Transaccional)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=concierge@gtrcars.es
SMTP_PASSWORD=contraseña-real-del-buzon
EMAIL_FROM=GTR Cars Club <concierge@gtrcars.es>

# 7. Pasarela de Pagos Stripe Connect
# Claves API de tu panel de Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
